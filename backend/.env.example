# ── Database ──────────────────────────────────────────────────────────────────
# Local Postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_teammate
# Supabase (replace with your project credentials)
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_a_64_char_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins or * for all
CORS_ORIGINS=["*"]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Leave blank to use the built-in rule-based AI engine
OPENAI_API_KEY=

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
