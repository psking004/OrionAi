# Node services (api-server, dashboard). Python backend settings live in backend/.env.example.
# All values are optional locally; defaults are shown in comments.

# Port for whichever service you start (api-server: 8080, dashboard: 5173, backend: 8000)
PORT=
# Public base path the dashboard is served under (default: /)
BASE_PATH=
# Where the Express api-server forwards /api/auth and /api/projects (default: http://localhost:8000)
FASTAPI_URL=
# Proxy timeout to FastAPI in ms (default: 120000)
FASTAPI_TIMEOUT_MS=
# Where the dashboard dev/preview server forwards /api (default: http://localhost:8080)
API_PROXY_TARGET=
# production | development
NODE_ENV=
